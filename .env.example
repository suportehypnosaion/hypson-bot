# ════════════════════════════════════════════════════════════════
# PSike Meet — Host Auto-Join Service — ALL configuration lives here.
# Copy to .env and fill in. Apply changes with:  docker compose up -d
# (plain `restart` does NOT re-read this file)
# ════════════════════════════════════════════════════════════════

# ─── PSike database (read-only access to `sessions`) ────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=<your_psike_db_user>
DB_PASSWORD=<your_psike_db_password>
DB_NAME=<your_psike_database_name>

# ─── Timing ──────────────────────────────────────────────────────
# How often to check the DB for sessions (seconds)
POLL_INTERVAL_SECONDS=30
# Host joins this many seconds BEFORE the scheduled session start.
# Negative = join AFTER start (e.g. -60 = 1 minute after).
JOIN_EARLY_SECONDS=-60
# Host stays this many seconds past the scheduled end (backstop;
# usually it leaves earlier via ALONE_LEAVE_SECONDS)
LEAVE_GRACE_SECONDS=300
# Once others joined and then ALL left, host leaves after this many
# seconds alone (buffer covers brief disconnects). 0 = disabled.
ALONE_LEAVE_SECONDS=60
# How many times to retry a session whose join failed
MAX_JOIN_ATTEMPTS=3

# ─── Browser ─────────────────────────────────────────────────────
# chrome = real Google Chrome (required — Google blocks sign-in on
# Playwright's bundled Chromium). msedge also works if installed.
BROWSER_CHANNEL=chrome
# true = invisible browser. Set false only for debugging on a desktop.
HEADLESS=true

# ─── Identity ────────────────────────────────────────────────────
# The central Workspace host account that joins every session
SUPORTE_EMAIL=<central_host_account_email>

# ─── Docker deployment ───────────────────────────────────────────
# Container timezone. The app stores session_date in UTC, so run the bot in
# UTC (and read the DB in UTC via DB_TIME_ZONE above).
TZ=UTC
# UID of the owner of ./browser-profile on the host (run `id -u`).
# Used at build time so the container user can read the profile.
HOST_UID=1000
# The app stores session_date in UTC, so read the DB in UTC and the
# join-window query (session_date vs NOW()) compares correctly. Keep this
# at +00:00 to match the backend. Empty = use the DB server default.
DB_TIME_ZONE=+00:00
